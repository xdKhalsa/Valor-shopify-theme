{% doc %}
  @prompt
    Create a featured-products block that changes which jewellery style is featured on each page visit, rather than merely sliding through a fixed set of products. Allow the merchant to select collections for oxidized jewellery, gold-plated jewellery, and other styles with collection pickers. Randomly choose one of the configured nonempty collections on page load and show its products with its collection title. Keep that selection stable while the shopper stays on the page. Match the existing theme design and product cards, make product count and heading editable, and support mobile. Do not invent collections or product details. This is intended to replace the current featured-products area, not duplicate it.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign configured_count = 0 %}
{% if block.settings.collection_oxidized != blank and block.settings.collection_oxidized.products_count > 0 %}{% assign configured_count = configured_count | plus: 1 %}{% endif %}
{% if block.settings.collection_gold != blank and block.settings.collection_gold.products_count > 0 %}{% assign configured_count = configured_count | plus: 1 %}{% endif %}
{% if block.settings.collection_style_three != blank and block.settings.collection_style_three.products_count > 0 %}{% assign configured_count = configured_count | plus: 1 %}{% endif %}
{% if block.settings.collection_style_four != blank and block.settings.collection_style_four.products_count > 0 %}{% assign configured_count = configured_count | plus: 1 %}{% endif %}
{% if configured_count > 0 %}
  {% assign random_seed = 'now' | date: '%s' | modulo: configured_count %}
  {% assign active_index = -1 %}
  {% assign active_collection = blank %}
  {% assign valid_index = 0 %}
  {% for slot in (1..4) %}
    {% case slot %}
      {% when 1 %}{% assign candidate = block.settings.collection_oxidized %}
      {% when 2 %}{% assign candidate = block.settings.collection_gold %}
      {% when 3 %}{% assign candidate = block.settings.collection_style_three %}
      {% when 4 %}{% assign candidate = block.settings.collection_style_four %}
    {% endcase %}
    {% if candidate != blank and candidate.products_count > 0 %}
      {% if valid_index == random_seed %}{% assign active_collection = candidate %}{% assign active_index = slot %}{% endif %}
      {% assign valid_index = valid_index | plus: 1 %}
    {% endif %}
  {% endfor %}
{% endif %}
{% style %}
  .ai-random-feature-{{ ai_gen_id }} { display:block; width:{{ block.settings.desktop_width_percent }}%; max-width:100%; color:#333333; }
  .ai-random-feature-{{ ai_gen_id }}__inner { width:100%; }
  .ai-random-feature-{{ ai_gen_id }}__heading { margin:0 0 24px; text-align:center; font-family:var(--font-heading-family, sans-serif); font-size:clamp(22px,3vw,34px); line-height:1.2; }
  .ai-random-feature-{{ ai_gen_id }}__grid { display:grid; grid-template-columns:repeat({{ block.settings.columns_desktop }},minmax(0,1fr)); gap:20px; }
  .ai-random-feature-{{ ai_gen_id }}__card { display:block; color:inherit; text-decoration:none; min-width:0; }
  .ai-random-feature-{{ ai_gen_id }}__image-wrap { display:block; position:relative; overflow:hidden; background:#f5f4f2; aspect-ratio:4/5; }
  .ai-random-feature-{{ ai_gen_id }}__image-wrap img { width:100%; height:100%; object-fit:cover; display:block; }
  .ai-random-feature-{{ ai_gen_id }}__placeholder { width:100%; height:100%; }
  .ai-random-feature-{{ ai_gen_id }}__placeholder svg { width:100%; height:100%; object-fit:cover; }
  .ai-random-feature-{{ ai_gen_id }}__product-title { margin:12px 0 5px; font-size:15px; line-height:1.4; }
  .ai-random-feature-{{ ai_gen_id }}__price { font-size:14px; }
  .ai-random-feature-{{ ai_gen_id }}__empty { text-align:center; padding:24px; background:#f5f4f2; color:#333; }
  @media(max-width:749px) {
    .ai-random-feature-{{ ai_gen_id }} { width:100%; }
    .ai-random-feature-{{ ai_gen_id }}__grid { grid-template-columns:repeat({{ block.settings.columns_mobile }},minmax(0,1fr)); gap:12px; }
    .ai-random-feature-{{ ai_gen_id }}__heading { margin-bottom:18px; }
  }
{% endstyle %}
<random-featured-products-{{ ai_gen_id }} class="ai-random-feature-{{ ai_gen_id }}" data-selection="{{ active_index }}" {{ block.shopify_attributes }}>
  {% if active_collection != blank %}
    <div class="ai-random-feature-{{ ai_gen_id }}__inner">
      <h2 class="ai-random-feature-{{ ai_gen_id }}__heading">{{ block.settings.heading | default: active_collection.title | escape }}</h2>
      <div class="ai-random-feature-{{ ai_gen_id }}__grid">
        {% for product in active_collection.products limit: block.settings.product_count %}
          <a class="ai-random-feature-{{ ai_gen_id }}__card" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
            <span class="ai-random-feature-{{ ai_gen_id }}__image-wrap">
              {% if product.featured_image %}
                {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 450, 600, 750, 900', alt: product.featured_image.alt | default: product.title | escape }}
              {% else %}
                <span class="ai-random-feature-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</span>
              {% endif %}
            </span>
            <span class="ai-random-feature-{{ ai_gen_id }}__product-title">{{ product.title | escape }}</span>
            <span class="ai-random-feature-{{ ai_gen_id }}__price">{{ product.price | money }}</span>
          </a>
        {% endfor %}
      </div>
    </div>
  {% else %}
    <div class="ai-random-feature-{{ ai_gen_id }}__empty">Choose one or more nonempty collections to display featured products.</div>
  {% endif %}
</random-featured-products-{{ ai_gen_id }}>
<script>
  (function() {
    const elementName = 'random-featured-products-{{ ai_gen_id }}';
    if (customElements.get(elementName)) return;
    class RandomFeaturedProducts extends HTMLElement {
      connectedCallback() {
        this.dataset.selection = this.dataset.selection || 'none';
      }
    }
    customElements.define(elementName, RandomFeaturedProducts);
  })();
</script>
{% schema %}
{
  "name": "Random featured products",
  "settings": [
    { "type": "header", "content": "Collections" },
    { "type": "collection", "id": "collection_oxidized", "label": "Oxidized jewellery" },
    { "type": "collection", "id": "collection_gold", "label": "Gold-plated jewellery" },
    { "type": "collection", "id": "collection_style_three", "label": "Other style 1" },
    { "type": "collection", "id": "collection_style_four", "label": "Other style 2" },
    { "type": "header", "content": "Display" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured jewellery" },
    { "type": "range", "id": "product_count", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "columns_desktop", "label": "Desktop columns", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "select", "id": "columns_mobile", "label": "Mobile columns", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }], "default": "2" }
  ],
  "presets": [{ "name": "Random featured products" }],
  "tag": null,
  "class": "random-featured-products-block"
}
{% endschema %}