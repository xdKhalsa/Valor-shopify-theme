{% doc %}
  @prompt
    Create a featured-products block that changes which jewellery style is featured on each page visit, rather than merely sliding through a fixed set of products. Allow the merchant to select collections for oxidized jewellery, gold-plated jewellery, and other styles with collection pickers. Randomly choose one of the configured nonempty collections on page load and show its products with its collection title. Keep that selection stable while the shopper stays on the page. Match the existing theme design and product cards, make product count and heading editable, and support mobile. Do not invent collections or product details. This is intended to replace the current featured-products area, not duplicate it., show atleast 8 to 12 products, and the need to be chaning every 1 hour to new products, also add heading edit options
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign configured_count = 0 %}
{% if block.settings.collection_oxidized != blank and block.settings.collection_oxidized.products_count > 0 %}{% assign configured_count = configured_count | plus: 1 %}{% endif %}
{% if block.settings.collection_gold != blank and block.settings.collection_gold.products_count > 0 %}{% assign configured_count = configured_count | plus: 1 %}{% endif %}
{% if block.settings.collection_style_three != blank and block.settings.collection_style_three.products_count > 0 %}{% assign configured_count = configured_count | plus: 1 %}{% endif %}
{% if block.settings.collection_style_four != blank and block.settings.collection_style_four.products_count > 0 %}{% assign configured_count = configured_count | plus: 1 %}{% endif %}
{% assign active_collection = blank %}
{% if configured_count > 0 %}
  {% assign current_hour = 'now' | date: '%s' | divided_by: 3600 %}
  {% assign chosen_collection_index = current_hour | modulo: configured_count %}
  {% assign valid_index = 0 %}
  {% for slot in (1..4) %}
    {% case slot %}
      {% when 1 %}{% assign candidate = block.settings.collection_oxidized %}
      {% when 2 %}{% assign candidate = block.settings.collection_gold %}
      {% when 3 %}{% assign candidate = block.settings.collection_style_three %}
      {% when 4 %}{% assign candidate = block.settings.collection_style_four %}
    {% endcase %}
    {% if candidate != blank and candidate.products_count > 0 %}
      {% if valid_index == chosen_collection_index %}{% assign active_collection = candidate %}{% endif %}
      {% assign valid_index = valid_index | plus: 1 %}
    {% endif %}
  {% endfor %}
{% endif %}
{% if active_collection != blank %}
  {% assign product_total = active_collection.products_count %}
  {% assign product_start = current_hour | times: 17 | modulo: product_total %}
  {% assign products_to_render = block.settings.product_count | at_most: product_total %}
{% endif %}
{% style %}
  .ai-random-feature-{{ ai_gen_id }} { display:block; width:{{ block.settings.desktop_width_percent }}%; max-width:100%; color:#333333; }
  .ai-random-feature-{{ ai_gen_id }}__heading { margin:0 0 24px; text-align:{{ block.settings.heading_alignment }}; font-family:{{ block.settings.heading_font.family }},{{ block.settings.heading_font.fallback_families }}; font-weight:{{ block.settings.heading_font.weight }}; font-size:{{ block.settings.heading_size }}px; line-height:1.2; color:{{ block.settings.heading_color }}; }
  .ai-random-feature-{{ ai_gen_id }}__grid { display:grid; grid-template-columns:repeat({{ block.settings.columns_desktop }},minmax(0,1fr)); gap:20px; }
  .ai-random-feature-{{ ai_gen_id }}__card { display:block; color:inherit; text-decoration:none; min-width:0; }
  .ai-random-feature-{{ ai_gen_id }}__image-wrap { display:block; position:relative; overflow:hidden; background:#f5f4f2; aspect-ratio:4/5; }
  .ai-random-feature-{{ ai_gen_id }}__image-wrap img { width:100%; height:100%; object-fit:cover; display:block; }
  .ai-random-feature-{{ ai_gen_id }}__placeholder { width:100%; height:100%; }
  .ai-random-feature-{{ ai_gen_id }}__placeholder svg { width:100%; height:100%; object-fit:cover; }
  .ai-random-feature-{{ ai_gen_id }}__product-title { display:block; margin:12px 0 5px; font-size:15px; line-height:1.4; }
  .ai-random-feature-{{ ai_gen_id }}__price { display:block; font-size:14px; }
  .ai-random-feature-{{ ai_gen_id }}__empty { text-align:center; padding:24px; background:#f5f4f2; color:#333; }
  @media(max-width:749px) { .ai-random-feature-{{ ai_gen_id }} { width:100%; } .ai-random-feature-{{ ai_gen_id }}__grid { grid-template-columns:repeat({{ block.settings.columns_mobile }},minmax(0,1fr)); gap:12px; } .ai-random-feature-{{ ai_gen_id }}__heading { margin-bottom:18px; font-size:{{ block.settings.heading_size | at_most: 32 }}px; } }
{% endstyle %}
<random-featured-products-{{ ai_gen_id }} class="ai-random-feature-{{ ai_gen_id }}" data-hour="{{ current_hour }}" {{ block.shopify_attributes }}>
  {% if active_collection != blank %}
    <h2 class="ai-random-feature-{{ ai_gen_id }}__heading">{% if block.settings.heading != blank %}{{ block.settings.heading | escape }}{% else %}{{ active_collection.title | escape }}{% endif %}</h2>
    <div class="ai-random-feature-{{ ai_gen_id }}__grid">
      {% for i in (0..11) %}
        {% if forloop.index <= products_to_render %}
          {% assign product_index = product_start | plus: i | modulo: product_total %}
          {% assign product = active_collection.products[product_index] %}
          {% if product != blank %}
            <a class="ai-random-feature-{{ ai_gen_id }}__card" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
              <span class="ai-random-feature-{{ ai_gen_id }}__image-wrap">
                {% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 450, 600, 750, 900', alt: product.featured_image.alt | default: product.title | escape }}{% else %}<span class="ai-random-feature-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</span>{% endif %}
              </span>
              <span class="ai-random-feature-{{ ai_gen_id }}__product-title">{{ product.title | escape }}</span>
              <span class="ai-random-feature-{{ ai_gen_id }}__price">{{ product.price | money }}</span>
            </a>
          {% endif %}
        {% endif %}
      {% endfor %}
    </div>
  {% else %}<div class="ai-random-feature-{{ ai_gen_id }}__empty">Choose one or more nonempty collections to display featured products.</div>{% endif %}
</random-featured-products-{{ ai_gen_id }}>
<script>
  (function() {
    const elementName = 'random-featured-products-{{ ai_gen_id }}';
    if (customElements.get(elementName)) return;
    class RandomFeaturedProducts extends HTMLElement { connectedCallback() { this.dataset.selectionStableForThisPage = 'true'; } }
    customElements.define(elementName, RandomFeaturedProducts);
  })();
</script>
{% schema %}
{
  "name": "Random featured products",
  "settings": [
    { "type": "header", "content": "Collections" },
    { "type": "collection", "id": "collection_oxidized", "label": "Oxidized jewellery" },
    { "type": "collection", "id": "collection_gold", "label": "Gold-plated jewellery" },
    { "type": "collection", "id": "collection_style_three", "label": "Other style 1" },
    { "type": "collection", "id": "collection_style_four", "label": "Other style 2" },
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading", "label": "Text", "default": "Featured jewellery" },
    { "type": "font_picker", "id": "heading_font", "label": "Font", "default": "work_sans_n6" },
    { "type": "range", "id": "heading_size", "label": "Size", "min": 20, "max": 48, "step": 2, "unit": "px", "default": 30 },
    { "type": "select", "id": "heading_alignment", "label": "Alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }], "default": "center" },
    { "type": "color", "id": "heading_color", "label": "Color", "default": "#333333" },
    { "type": "header", "content": "Products" },
    { "type": "range", "id": "product_count", "label": "Products to show", "min": 8, "max": 12, "step": 1, "default": 8 },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "columns_desktop", "label": "Desktop columns", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "select", "id": "columns_mobile", "label": "Mobile columns", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }], "default": "2" }
  ],
  "presets": [{ "name": "Random featured products" }],
  "tag": null,
  "class": "random-featured-products-block"
}
{% endschema %}